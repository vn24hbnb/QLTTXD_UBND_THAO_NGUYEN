{
  "name": "qlttxd-thao-nguyen",
  "version": "1.1.0",
  "description": "Hệ thống Quản lý Trật tự Xây dựng phường Thảo Nguyên, tỉnh Sơn La (Mốc A thử nghiệm)",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "seed": "node src/db/seed.js",
    "test": "node --import ./tests/setup.js --test tests/*.test.js",
    "benchmark": "node tests/load_benchmark.js",
    "backup": "node scripts/backup.js",
    "restore": "node scripts/restore.js",
    "backup:cloud": "node --env-file-if-exists=.env scripts/backup-cloud.js",
    "restore:cloud": "node scripts/restore-cloud.js",
    "verify:postgres-restore": "node scripts/verify-postgres-restore.js",
    "verify:deployment": "node scripts/verify-deployment.js",
    "verify:backup-freshness": "node scripts/check-backup-freshness.js"
  },
  "keywords": [
    "qlttxd",
    "gis",
    "leaflet",
    "son-la",
    "thao-nguyen"
  ],
  "author": "Đội dự án QLTTXD Thảo Nguyên",
  "license": "UNLICENSED",
  "dependencies": {
    "@supabase/supabase-js": "2.116.0",
    "pg": "8.23.0",
    "sharp": "0.35.4"
  },
  "engines": {
    "node": "24.x"
  }
}
